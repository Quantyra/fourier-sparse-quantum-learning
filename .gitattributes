* text=auto eol=lf
*.pdf binary
*.png binary
reviews/*.md whitespace=-blank-at-eol
# Preserve blank context lines in exact review diff packets.
reviews/*.txt whitespace=-blank-at-eol
reviews/v0.2.0/*.md whitespace=-blank-at-eol
reviews/v0.2.0/*.txt whitespace=-blank-at-eol

reviews/v0.3.0/*.md whitespace=-blank-at-eol
reviews/v0.3.0/*.txt whitespace=-blank-at-eol

reviews/v0.4.0/*.md whitespace=-blank-at-eol
# Preserve the exact submitted packets, including their final blank context line.
reviews/v0.4.0/*.txt whitespace=-blank-at-eol,-blank-at-eof
